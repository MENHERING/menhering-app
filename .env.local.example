# 이 파일은 견본(커밋됨)입니다. 복사해서 .env.local / .env 에 실제 값을 채우세요.
#   - .env.local : 로컬 개발용 (gitignore)
#   - .env       : 배포용 (gitignore)
# 새 환경변수를 추가하면 env.d.ts에도 타입을 정의해야 자동완성이 됩니다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 OIDC 로그인 (서버 전용) — Kakao Developers > 앱 키 REST API 키 / 보안 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 웹 푸시(VAPID) — `npx web-push generate-vapid-keys`로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 연락처 URI (mailto:you@example.com 또는 https://도메인). web-push 필수값.
VAPID_SUBJECT=

# 스케줄 발송(Vercel Cron) 인증 시크릿 — 임의 랜덤 문자열. Vercel이 Authorization: Bearer 헤더로 자동 전송한다.
CRON_SECRET=
