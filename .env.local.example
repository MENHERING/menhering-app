# 이 파일은 견본(커밋됨)입니다. 복사해서 .env.local / .env 에 실제 값을 채우세요.
#   - .env.local : 로컬 개발용 (gitignore)
#   - .env       : 배포용 (gitignore)
# 새 환경변수를 추가하면 env.d.ts에도 타입을 정의해야 자동완성이 됩니다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 OIDC 로그인 (서버 전용) — Kakao Developers > 앱 키 REST API 키 / 보안 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
